pe=Dtype.string, timestamp_format=None), Column(name='age', stype=Stype.numerical, dtype=Dtype.float64, timestamp_format=None), Column(name='postal_code', stype=Stype.ID, dtype=Dtype.string, timestamp_format=None)], 'pkey': 'customer_id', 'time_col': None, 'end_time_col': None}\n\ncustomers = kumo.Table(\n    source_table=hnm_new_downsampled_test_deletion_connector.table(customers_config[\"table_name\"]),\n    columns=customers_config[\"cols\"],\n    primary_key=customers_config['pkey'],\n    time_column=customers_config['time_col'],\n    end_time_column=customers_config[\"end_time_col\"]\n)\n\ntransactions_2020_config = {'connector_id': 'hnm_new_downsampled_test_deletion', 'table_name': 'transactions_2020', 'file_type': 'PARQUET', 'table_name_alias': 'transactions_test_deletion', 'cols': [Column(name='t_dat', stype=Stype.timestamp, dtype=Dtype.date, timestamp_format=None), Column(name='customer_id', stype=Stype.ID, dtype=Dtype.string, timestamp_format=None), Column(name='article_id', stype=Stype.ID, dtype=Dtype.int64, timestamp_format=None), Column(name='price', stype=Stype.numerical, dtype=Dtype.float64, timestamp_format=None), Column(name='sales_channel_id', stype=Stype.ID, dtype=Dtype.int64, timestamp_format=None)], 'pkey': None, 'time_col': 't_dat', 'end_time_col': None}\n\ntransactions_2020 = kumo.Table(\n    source_table=hnm_new_downsampled_test_deletion_connector.table(transactions_2020_config[\"table_name\"]),\n    columns=transactions_2020_config[\"cols\"],\n    primary_key=transactions_2020_config['pkey'],\n    time_column=transactions_2020_config['time_col'],\n    end_time_column=transactions_2020_config[\"end_time_col\"]\n)\n\ngraph = kumo.Graph(\n    tables={'articles': articles, 'customers': customers, 'transactions_2020': transactions_2020},\n    edges=[{'src_table': 'transactions_2020', 'fkey': 'article_id', 'dst_table': 'articles'}, {'src_table': 'transactions_2020', 'fkey': 'customer_id', 'dst_table': 'customers'}],\n)\n\ngraph.validate()\n\n"
