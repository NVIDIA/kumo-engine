        ],
        "routes": ["/models/trainingtable/"],
        "recipeKeys": ["training_table_details"]
    },
    {
        "key": "prediction_detail_workflows",
        "description": "Prediction detail page",
        "patterns": [
            "^ui/src/components/Jobs/Prediction/PredictionJobOverview",
            "^ui/src/components/Jobs/Prediction/PredictionJob.tsx"
        ],
        "routes": ["/predictions/prediction/"],
        "recipeKeys": ["prediction_details"]
    },
    {
        "key": "prediction_table_detail_workflows",
        "description": "Prediction table generation detail page",
        "patterns": [
