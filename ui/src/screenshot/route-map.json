        "patterns": ["^ui/src/pages/Jobs/JobsList"],
        "routes": ["/models/", "/predictions/"],
        "recipeKeys": ["jobs_lists"]
    },
    {
        "key": "model_list_workflows",
        "description": "Model list page",
        "patterns": [
            "^ui/src/pages/Jobs/JobsList\\.tsx$",
            "^ui/src/pages/Jobs/__tests__/ModelList\\.test\\.tsx$"
        ],
        "routes": ["/models/"],
        "recipeKeys": ["models_list"]
    },
    {
        "key": "prediction_list_workflows",
        "description": "Prediction list page",
        "patterns": [
            "^ui/src/pages/Jobs/JobsList\\.tsx$",
            "^ui/src/pages/Jobs/__tests__/PredictionList\\.test\\.tsx$"
        ],
        "routes": ["/predictions/"],
        "recipeKeys": ["predictions_list"]
    },
    {
        "key": "model_detail_workflows",
        "description": "Model detail page",
        "patterns": [
            "^ui/src/components/Jobs/Training/TrainingJobOverview",
