        "patterns": ["^ui/src/components/Tables/Connect/"],
        "routes": ["/tables/new-table"],
        "recipeKeys": ["new_table"]
    },
    {
        "key": "graph_creation_workflow",
        "description": "Graph creation, table selection, and graph setup workflow",
        "patterns": [
            "^ui/src/pages/Graphs/NewGraph/",
            "^ui/src/components/Graphs/GraphConfigPanel/",
            "^ui/src/components/Graphs/LinkSetup/",
            "^ui/src/components/Graphs/NameInput/"
        ],
        "routes": ["/graphs/new-graph"],
