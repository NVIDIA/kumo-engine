    {
        "key": "project_settings_workflow",
        "description": "Project settings workflow",
        "patterns": ["^ui/src/components/Project/ProjectSettings"],
        "routes": ["/project/settings/"],
        "recipeKeys": ["project_settings"]
    },
    {
        "key": "project_list_workflow",
        "description": "Project switcher dialog workflow",
        "patterns": ["^ui/src/components/Project/ProjectList"],
        "routes": ["/connectors/"],
        "recipeKeys": ["project_list"]
    },
    {
        "key": "new_project_workflow",
        "description": "New Project dialog workflow",
        "patterns": ["^ui/src/components/Project/NewProject"],
        "routes": ["/connectors/"],
        "recipeKeys": ["new_project"]
    },
    {
        "key": "project_forms_workflow",
        "description": "Shared project form controls",
        "patterns": ["^ui/src/components/Project/NameInput/ProjectNameInput"],
        "routes": ["/project/settings/", "/connectors/"],
        "recipeKeys": ["project_forms"]
