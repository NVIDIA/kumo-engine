[
    {
        "key": "new_training_workflow",
        "description": "New Training page and model planner workflow",
        "patterns": [
            "^ui/src/pages/NewJob/Training/",
            "^ui/src/components/NewJob/Training/",
            "^ui/src/components/PredictiveQueries/Training/ModelPlanner",
            "^ui/src/components/PredictiveQueries/Write/ModelPlanner"
        ],
        "routes": ["/newjob/training/"],
        "recipeKeys": ["new_training"]
    },
    {
        "key": "new_training_graph_preview",
        "description": "New Training graph preview and table view workflow",
        "patterns": ["^ui/src/components/Graphs/InformationPanel/"],
        "routes": ["/newjob/training/"],
        "recipeKeys": ["new_training_graph_table_view"]
    },
    {
        "key": "new_prediction_workflow",
        "description": "New Prediction workflow",
        "patterns": [
            "^ui/src/pages/NewJob/Prediction/",
            "^ui/src/components/NewJob/Prediction/"
        ],
        "routes": ["/newjob/prediction/"],
        "recipeKeys": ["new_prediction"]
    },
    {
        "key": "connector_creation_workflow",
        "description": "Connector creation and source selection workflow",
        "patterns": ["^ui/src/pages/Connectors/NewConnector/"],
        "routes": ["/connectors/new-connector"],
        "recipeKeys": ["new_connector"]
    },
    {
        "key": "table_creation_workflow",
