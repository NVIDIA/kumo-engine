            "^ui/src/components/Jobs/PredictionTable/PredictionTableGenOverview\\.tsx$"
        ],
        "routes": ["/predictions/predictiontable/"],
        "recipeKeys": ["prediction_table_details"]
    },
    {
        "key": "prediction_outputs_workflows",
        "description": "Prediction outputs panel",
        "patterns": [
            "^ui/src/components/BatchPredictions/PredictionOutputsOverview/"
        ],
        "routes": ["/predictions/prediction/"],
        "recipeKeys": ["prediction_outputs"]
