    "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
    "globals": "^14.0.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "knip": "^6.13.1",
    "lint-staged": "^16.1.6",
    "madge": "^8.0.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.50.1",
    "vite-plugin-checker": "^0.10.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.0",
    "vitest-preview": "^0.0.3"
  },
  "lint-staged": {
    "*.{tsx,ts,js}": [
      "prettier --write",
      "eslint --fix --config eslint.config.ts"
    ],
    "*.{css,scss,md,json}": "prettier --write"
  }
}
