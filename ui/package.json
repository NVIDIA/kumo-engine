  "scripts": {
    "start": "bash scripts/setup-tsconfig.sh --reset && npm run update-env && vite",
    "start:catalog": "bash scripts/setup-tsconfig.sh --local && UI_CATALOG_PATH=${CATALOG_PATH:-../packages/kumo-ui-catalog} npm run update-env && UI_CATALOG_PATH=${UI_CATALOG_PATH:-../packages/kumo-ui-catalog} vite",
    "local": "bash scripts/setup-tsconfig.sh --reset && UI_LOCAL=true npm run update-env && UI_LOCAL=true API_PROXY_TARGET=${API_PROXY_TARGET:-http://127.0.0.1:10001} vite",
    "local:remote": "REACT_APP_PORT=${REACT_APP_PORT:-3001} API_PROXY_TARGET=${API_PROXY_TARGET:-http://127.0.0.1:10001} npm run local",
    "local:catalog": "bash scripts/setup-tsconfig.sh --local && UI_LOCAL=true UI_CATALOG_PATH=${UI_CATALOG_PATH:-../packages/kumo-ui-catalog} npm run update-env && UI_LOCAL=true API_PROXY_TARGET=${API_PROXY_TARGET:-http://127.0.0.1:10001} UI_CATALOG_PATH=${UI_CATALOG_PATH:-../packages/kumo-ui-catalog} vite",
    "remote": "bash scripts/remote.sh",
    "install:catalog": "npm --prefix ../packages/kumo-ui-catalog ci --legacy-peer-deps && npm --prefix ../packages/kumo-ui-catalog run build",
    "build": "npm run type-check && NODE_OPTIONS='--max-old-space-size=6144' vite build && node scripts/check-built-index-csp.mjs && npm run update-env && mv build/assets/*.js.map stacktracer/source_map/",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "vitest-preview": "vitest-preview",
    "coverage": "vitest run --coverage",
    "update-env": "mkdir -p build/ && sed -e \"s/__UI_LOCAL__/${UI_LOCAL:-false}/g\" -e \"s/__AUTH_DISABLED__/${AUTH_DISABLED:-false}/g\" env.js > public/env-config.js && cp public/env-config.js build/env-config.js",
    "compile-grammar-to-ts": "antlr4ts ../packages/kumo-pql/kumopql/grammar/PQLGrammar.g4 -visitor -o src/utils/PQLParsing/grammar -Xexact-output-dir && node scripts/normalize-generated-grammar.mjs src/utils/PQLParsing/grammar",
    "lint": "eslint --fix --config eslint.config.ts",
    "lint-check": "eslint --fix-dry-run --config eslint.config.ts",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "circular-check": "madge --circular --extensions ts,tsx --exclude '^(gen/|utils/PQLParsing/grammar/)' src/",
    "knip": "knip",
    "knip:files": "knip --files",
    "knip:strict": "knip --strict",
    "knip:production": "knip --production",
    "knip:production:files": "echo 'Unused files (used only in tests):' && knip --production --include files",
    "dead-tests": "node scripts/find-dead-tests.mjs",
    "validate:skills": "bash ../.agents/skills/build-ui/scripts/validate-skill-structure.sh",
    "validate:screenshot-catalog": "vitest run scripts/__tests__/screenshot-catalog.test.mjs scripts/__tests__/screenshot-plan-helper.test.mjs",
    "fix-generated-syntax": "node src/utils/fixGeneratedSyntax.cjs",
    "lint-format-codegen": "npm run fix-generated-syntax && npm run lint && npm run fix-generated-syntax && prettier --write src/gen/${npm_config_subdir:-}",
    "inject-zod-schemas": "node src/utils/injectZodSchemas.cjs",
    "screenshots:ci": "node scripts/ci-screenshot.mjs",
    "screenshots:build-ui": "node scripts/build-ui-local-screenshot.mjs",
    "audit": "node scripts/ui-baseline-audit.mjs",
    "audit:write": "node scripts/ui-baseline-audit.mjs --write",
    "audit:report": "node scripts/ui-baseline-audit.mjs --report",
    "audit:check": "node scripts/ui-baseline-audit.mjs --check"
  },
  "overrides": {
    "nanoid@>=3.0.0 <4.0.0": "3.3.18",
    "autoprefixer": "10.4.20",
    "@babel/core": "7.29.6",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "flatted": "3.4.2",
    "hono": "4.13.5",
    "@hono/node-server": "2.0.12",
    "ip-address": "10.4.0",
    "nth-check": "2.1.1",
    "postcss": "8.5.25",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "body-parser": "2.3.0",
    "linkify-it": "5.0.2",
    "markdown-it": "14.3.1",
    "qs": "6.16.0",
    "smol-toml": "1.7.1",
    "immutable@>=4.0.0 <5.0.0": "4.3.9",
