    "brace-expansion@>=1.0.0 <2.0.0": "1.1.21",
    "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
    "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
    "vitest-preview": {
      "vite": "7.3.5"
    },
    "router": {
      "path-to-regexp": "8.4.0"
    },
    "form-data": "4.0.6",
    "ws": "8.21.0",
    "orval": {
      "js-yaml": "4.3.2"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
