{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["storageClass", "machineAutoscalers", "operators", "nfd", "clusterPolicy"],
  "properties": {
    "storageClass": {
      "type": "object",
      "required": ["create", "name", "skuName", "fsType"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "skuName": {"const": "Premium_LRS"},
        "fsType": {"const": "xfs"}
      }
    },
    "machineAutoscalers": {
      "type": "object",
      "required": ["enabled", "minReplicas", "maxReplicas", "cacheMachineSets", "ephemeralMachineSet"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"const": 0},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "cacheMachineSets": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "ephemeralMachineSet": {"type": "string", "minLength": 1}
      }
    },
    "operators": {
      "type": "object",
      "required": ["mode", "nfdChannel", "gpuChannel", "sourceNamespace", "nfdSource", "gpuSource"],
      "properties": {
        "mode": {"type": "string", "enum": ["existing", "dedicated"]},
        "nfdChannel": {"type": "string", "minLength": 1},
        "gpuChannel": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+$"},
        "sourceNamespace": {"type": "string", "minLength": 1},
        "nfdSource": {"type": "string", "minLength": 1},
        "gpuSource": {"type": "string", "minLength": 1}
      }
    },
    "nfd": {
      "type": "object",
      "required": ["create", "name", "operandImage", "imagePullPolicy"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "operandImage": {"type": "string", "minLength": 1},
        "imagePullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "clusterPolicy": {
      "type": "object",
      "required": ["create", "name", "dcgmExporterEnabled"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "dcgmExporterEnabled": {"type": "boolean"}
      }
    }
  }
}
