{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["clusterName", "karpenter", "nodePools", "storageClass", "devicePlugin"],
  "properties": {
    "clusterName": {"type": "string", "minLength": 1},
    "karpenter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeRole", "amiAlias", "cacheGpuInstanceStorePolicy", "cacheGpuRootVolumeGiB", "subnetSelectorTags", "securityGroupSelectorTags"],
      "properties": {
        "nodeRole": {"type": "string", "minLength": 1},
        "amiAlias": {
          "type": "string",
          "pattern": "^al2023@",
          "description": "AL2023 only because the cache root mapping targets /dev/xvda and replaces the AMI's default mappings."
        },
        "cacheGpuInstanceStorePolicy": {
          "type": "string",
          "enum": ["", "RAID0"],
          "description": "DiskGraph cache nodes only: RAID0 gives local NVMe to kubelet; \"\" leaves it raw for a local-volume CSI driver."
        },
        "cacheGpuRootVolumeGiB": {
          "type": "integer",
          "minimum": 50,
          "description": "Root EBS volume for DiskGraph cache nodes, in GiB. Increase it when /mnt/ebs-scratch ingest spill needs more than the default."
        },
        "subnetSelectorTags": {"type": "object", "minProperties": 1},
        "securityGroupSelectorTags": {"type": "object", "minProperties": 1}
      }
    },
    "nodePools": {
      "type": "object",
      "required": ["cpu", "cacheTiers", "ephemeral", "expireAfter", "consolidateAfter"],
      "properties": {
        "cpu": {
          "allOf": [
            {"$ref": "#/definitions/pool"},
            {
              "type": "object",
              "required": ["labels"],
              "properties": {
                "labels": {
                  "type": "object",
                  "propertyNames": {"$ref": "#/definitions/labelKey"},
                  "additionalProperties": {"$ref": "#/definitions/labelValue"}
                }
              }
            }
          ]
        },
        "cacheTiers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/definitions/cacheTier"}
        },
        "ephemeral": {"$ref": "#/definitions/pool"},
        "expireAfter": {"type": "string", "minLength": 1},
        "consolidateAfter": {"type": "string", "minLength": 1}
      }
    },
    "storageClass": {
      "type": "object",
      "required": ["create", "name", "volumeType", "fsType", "encrypted", "reclaimPolicy"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1},
        "volumeType": {"const": "gp3"},
        "fsType": {"const": "xfs"},
        "encrypted": {"const": true},
        "reclaimPolicy": {"const": "Delete"}
      }
    },
    "devicePlugin": {
      "type": "object",
      "required": ["enabled", "image", "nodeSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1},
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "nodeSelector": {"type": "object", "minProperties": 1}
      }
    }
  },
  "definitions": {
    "labelKey": {
      "type": "string",
      "allOf": [
        {"pattern": "^(([a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"},
        {"not": {"pattern": "^.{254,}/"}}
      ]
    },
    "labelValue": {
      "type": "string",
      "pattern": "^$|^[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$"
    },
    "pool": {
      "type": "object",
      "required": ["instanceTypes", "capacityTypes", "maxCpu"],
      "properties": {
        "enabled": {"type": "boolean"},
        "instanceTypes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "capacityTypes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "enum": ["on-demand", "spot"]}
        },
        "maxCpu": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "cacheTier": {
      "allOf": [
        {"$ref": "#/definitions/pool"},
        {
          "type": "object",
          "required": ["name", "ssdGiB", "gpuCount"],
          "properties": {
            "name": {"type": "string", "pattern": "^[a-z0-9-]+$"},
            "ssdGiB": {"type": "integer", "minimum": 1},
            "gpuCount": {"type": "integer", "minimum": 1}
          }
        }
      ]
    }
  }
}
