# Set default value for CUDA env variable without requiring all users to
# define them in local environment.
export PANTS_PLATFORM="${PANTS_PLATFORM:-$(uname)}"
export PANTS_ARCH="${PANTS_ARCH:-$(uname -m)}"
export CUDA="${CUDA:-cpu}"
if [[ "${PANTS_PYTHON_RESOLVES_TO_CONSTRAINTS_FILE:-}" == '{"python-default":"3rdparty/default_cu130_aarch64.constraints.txt"}' ]]; then
  unset PANTS_PYTHON_RESOLVES_TO_CONSTRAINTS_FILE
fi

# Set lockfile path based on platform
if [[ "$PANTS_PLATFORM" == "Darwin" ]]; then
  export CUDA=cpu
  export PANTS_LOCKFILE_PATH="3rdparty/default_${CUDA}_macos.lock"
else
  if [[ "$CUDA" != "cpu" && "$CUDA" != "cu130" ]]; then
    echo "ERROR: unsupported CUDA selector '$CUDA'; expected cpu or cu130" >&2
    return 1
  fi
  if [[ "$CUDA" == "cu130" && ( "$PANTS_ARCH" == "aarch64" || "$PANTS_ARCH" == "arm64" ) ]]; then
    export PANTS_LOCKFILE_PATH="3rdparty/default_cu130_aarch64.lock"
    export PANTS_PYTHON_RESOLVES_TO_CONSTRAINTS_FILE='{"python-default":"3rdparty/default_cu130_aarch64.constraints.txt"}'
  else
    export PANTS_LOCKFILE_PATH="3rdparty/default_${CUDA}.lock"
  fi
fi
