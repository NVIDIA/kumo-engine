{
    "name": "@kumo-ai/kumo-ui-catalog",
    "version": "2.1.0",
    "type": "module",
    "main": "dist/index.umd.js",
    "module": "dist/index.es.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.es.js",
            "require": "./dist/index.umd.js"
        },
        "./kumo-ui-catalog.css": "./dist/kumo-ui-catalog.css"
    },
    "files": [
        "dist",
        "src/kumo-ui-catalog.css"
    ],
    "scripts": {
        "dev": "vite",
        "install-pack": "npm ci --legacy-peer-deps",
        "update-package-lock": "npm i --legacy-peer-deps",
        "build": "tsc -b && vite build && cp src/kumo-ui-catalog.css dist/kumo-ui-catalog.css",
        "build-dev": "npm run build",
        "preview": "vite preview",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "lint": "eslint --fix --config eslint.config.ts",
        "lint-check": "eslint --fix-dry-run --config eslint.config.ts",
        "format": "prettier --write .",
        "format-check": "prettier --check .",
        "type-check": "tsc --noEmit",
        "test": "vitest --config .storybook/vitest.config.ts",
        "test:watch": "vitest --config .storybook/vitest.config.ts --watch",
        "test:ci": "vitest run --config .storybook/vitest.config.ts --no-update",
        "test:a11y:report": "bash scripts/a11y-report.sh",
        "test:a11y:html": "bash scripts/a11y-html-report.sh",
        "test:storybook": "vitest --config .storybook/vitest.config.ts",
        "test:update": "vitest run --config .storybook/vitest.config.ts --no-cache -u",
        "test:visual": "vitest run --config .storybook/vitest.visual.config.ts",
        "test:visual:update": "vitest run --config .storybook/vitest.visual.config.ts --update",
        "test:visual:report": "bash scripts/visual-report.sh",
        "test:visual:html": "bash scripts/visual-html-report.sh",
        "coverage": "vitest run --config .storybook/vitest.config.ts --coverage"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "1.2.12",
        "@radix-ui/react-avatar": "1.1.11",
        "@radix-ui/react-checkbox": "1.3.3",
        "@radix-ui/react-collapsible": "1.1.12",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-hover-card": "1.1.15",
        "@radix-ui/react-label": "2.1.8",
        "@radix-ui/react-popover": "1.1.15",
        "@radix-ui/react-progress": "1.1.8",
        "@radix-ui/react-radio-group": "1.3.8",
        "@radix-ui/react-scroll-area": "1.2.10",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-separator": "1.1.8",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-slot": "1.2.4",
        "@radix-ui/react-switch": "1.2.6",
        "@radix-ui/react-tabs": "1.1.13",
        "@radix-ui/react-toggle-group": "1.1.11",
        "@radix-ui/react-tooltip": "1.2.8",
        "@tailwindcss/vite": "4.1.18",
        "@tanstack/react-table": "8.21.3",
        "@tanstack/react-virtual": "3.13.18",
        "@tisoap/react-flow-smart-edge": "3.0.0",
        "@types/d3-force": "3.0.10",
        "@types/react-syntax-highlighter": "15.5.13",
        "@xyflow/react": "12.10.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "cmdk": "1.1.1",
        "d3": "7.9.0",
        "date-fns": "3.6.0",
        "echarts": "6.1.0",
        "echarts-for-react": "3.0.5",
        "lucide-react": "0.477.0",
        "next-themes": "0.4.6",
        "prettier-plugin-tailwindcss": "0.6.14",
        "react-copy-to-clipboard": "5.1.0",
        "react-day-picker": "8.10.1",
        "react-markdown": "10.1.0",
        "react-syntax-highlighter": "16.1.0",
        "rehype-raw": "7.0.0",
        "remark-gfm": "4.0.1",
        "shadcn": "2.10.0",
        "sonner": "2.0.7",
        "tailwind-merge": "3.4.0",
        "tailwindcss": "4.1.18",
        "tailwindcss-animate": "1.0.7"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "5.0.0",
