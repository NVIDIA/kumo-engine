        "@types/react-copy-to-clipboard": "5.0.7",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "4.7.0",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-istanbul": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "ajv": "8.18.0",
        "eslint": "9.39.2",
        "eslint-plugin-react-hooks": "5.2.0",
        "eslint-plugin-react-refresh": "0.4.26",
        "eslint-plugin-storybook": "10.2.3",
        "globals": "15.15.0",
        "happy-dom": "20.9.0",
        "husky": "9.1.7",
        "lint-staged": "15.5.2",
        "playwright": "1.58.1",
        "prettier": "3.5.3",
        "react": "19.2.1",
        "react-dom": "19.2.1",
        "storybook": "^10.2.10",
        "typescript": "5.6.3",
        "typescript-eslint": "8.53.0",
        "vite": "6.4.3",
        "vite-plugin-css-injected-by-js": "3.5.2",
        "vite-plugin-dts": "4.5.4",
        "vitest": "4.1.11",
        "vitest-browser-react": "2.0.5"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "overrides": {
        "ajv-draft-04": {
            "ajv": "8.17.1"
        },
        "@babel/core": "7.29.6",
        "@hono/node-server": "1.19.15",
        "@humanfs/node": "0.16.8",
        "baseline-browser-mapping": "2.11.0",
        "body-parser": "2.3.0",
        "brace-expansion@>=1.0.0 <2.0.0": "1.1.21",
        "brace-expansion@>=2.0.0 <3.0.0": "2.1.7",
        "brace-expansion@>=5.0.0 <6.0.0": "5.0.12",
        "browserslist": "4.28.7",
        "storybook": {
            "esbuild": "0.28.1"
        },
        "@storybook/csf-plugin": {
            "esbuild": "0.28.1"
        },
        "fast-uri": "3.1.8",
        "hono": "4.13.7",
        "ip-address": "10.7.1",
        "js-yaml": "4.3.2",
        "nanoid@>=3.0.0 <4.0.0": "3.3.18",
        "postcss": "8.5.23",
        "qs": "6.16.0",
        "ws": "8.21.0"
    },
    "engines": {
        "node": "22.x"
    },
    "eslintConfig": {
        "extends": [
            "plugin:storybook/recommended"
        ]
    },
    "lint-staged": {
        "*.{tsx,ts,js}": [
            "prettier --write",
            "eslint --fix --config eslint.config.ts"
        ],
        "*.{css,scss,md,json}": "prettier --write"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/kumo-ai/kumo.git",
        "directory": "packages/kumo-ui-catalog"
    },
    "private": true
}
