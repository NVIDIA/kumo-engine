# Common env variables for REST API and temporal workers (but not UI).
# Deploy config is in rest/devserver/configs/<variant>.json.
#
# Identity:
DEPLOY_STAGE=dev
DISABLE_AUTH=true
ENABLE_ASYNC_INGESTION=1
#
# Feature flags:
DISABLE_MULTILABEL_RANKING=false
ENABLE_BIGQUERY=true
ENABLE_COLUMN_ANALYSIS=true
ENABLE_DATABRICKS=false
OPTIMIZE_STATIC_ENTITY_FILTER=true
USE_DECOUPLED_SPLITS=false
ENABLE_INDIVIDUAL_SPLIT_TABLES=true
ENABLE_UI_SCHEMA_VALIDATION=true
ALLOW_LOCAL_CONNECTOR=true
#
# Database:
IS_DB_ENABLED=false
ENABLE_DB_WRITE=false
ENABLE_DB_READ=false
