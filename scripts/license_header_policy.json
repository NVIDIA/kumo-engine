      "Dockerfile": ["hash"]
    },
    "basename_suffixes": {
      ".Dockerfile": ["hash"],
      ".tfvars.example": ["hash"]
    },
    "path_styles": {
      "helm/kumo-stack/renderer/templates/namespace-labels.txt": ["helm"],
      "helm/kumo-stack/renderer/templates/runtime.txt": ["helm"]
    },
    "include_shebang_files": true
  },
  "preamble_exceptions": [
    {
      "path": "packages/kumo-sdk/kumoai_studio/_version.py",
      "line_pattern": "^__version__\\s*=\\s*(['\\\"]).+\\1$",
      "reason": "Release automation requires the version assignment on line 1."
    }
  ],
