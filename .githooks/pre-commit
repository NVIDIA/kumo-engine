#!/usr/bin/env bash
set -euo pipefail

echo "Running cargo fmt --check..."
if ! cargo fmt --check 2>/dev/null; then
    echo "Formatting check failed. Run 'cargo fmt' to fix."
    exit 1
fi

echo "Running cargo clippy..."
if ! cargo clippy --workspace --all-targets -- -D warnings 2>/dev/null; then
    echo "Clippy check failed. Fix the warnings above."
    exit 1
fi

echo "Running Python tests in diskgraph-pybind..."
if [ -d "diskgraph-pybind" ]; then
    cd diskgraph-pybind
    # Use existing environment if available, otherwise tests will just fail or be skipped
    if command -v pytest &> /dev/null; then
        PYTHONPATH=python pytest python/tests/
    else
        echo "pytest not found. Skipping Python tests in pre-commit hook."
    fi
fi

