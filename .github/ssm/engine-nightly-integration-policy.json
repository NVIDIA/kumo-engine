{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendNightlyIntegrationToOneVM",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-2:926922431314:instance/i-06dd0e3c558780731",
        "arn:aws:ssm:us-east-2:926922431314:document/KumoEngineNightlyIntegration"
      ]
    },
    {
      "Sid": "ObserveAndCancelCommandsInNightlyRegion",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:CancelCommand"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    }
  ]
}
