# This script installs dependencies for Kumo runtime docker image

CUDA_VERSION=cu130
TORCH_VERSION=2.12.0

sudo apt-get update -y
sudo apt-get install -y curl lsb-release software-properties-common
sudo add-apt-repository -y ppa:deadsnakes/ppa
curl -sL https://deb.nodesource.com/setup_22.x | sudo -E bash -

sudo apt-get update -y
# Install the dependencies. Please keep this list sorted.
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends apt-utils \
cmake \
g++ \
gcc \
gdb \
git \
gnupg2 \
graphviz \
libkrb5-dev \
libxml2-dev \
libxslt1-dev \
nodejs \
nvidia-utils-470 \
pass \
python3.14 \
python3.14-dbg \
python3.14-dev \
ssh \
openjdk-17-jre-headless \
vim \
zlib1g-dev && \
sudo apt-get clean && \
sudo apt-get autoremove && \
sudo rm -rf /var/lib/apt/lists/*

sudo rm -rf /usr/bin/python3.6 /usr/bin/python3.6 /usr/bin/python /usr/bin/python3 && \
sudo rm -rf /usr/bin/python3.8 /usr/bin/python3.8 /usr/bin/python /usr/bin/python3 && \
sudo ln -s /usr/bin/python3.14 /usr/bin/python && \
sudo ln -s /usr/bin/python3.14 /usr/bin/python3
curl -sS https://bootstrap.pypa.io/get-pip.py | python3

python3 -m pip --version
python --version
python3 -m pip install --upgrade setuptools==68.2.2 pip

# Install python packages
python3 -m pip install numpy wheel awscli

# Install torch and pyg packages
python3 -m pip install torch==${TORCH_VERSION} --extra-index-url https://download.pytorch.org/whl/${CUDA_VERSION}

# Install JupyterLab server
python3 -m pip install jupyterlab
python3 -m pip install jupyter_server
python3 -m pip install jupyterlab_server

# Install Jupyter python packages
python3 -m pip install jupyterlab-nvdashboard
python3 -m pip install jupytext
python3 -m pip install ipywidgets

# Remove pip cache
python3 -m pip cache purge

# Verify packages
python3 -c "import torch"
