FROM --platform=linux/amd64 ubuntu:22.04

# Legacy image used by older Snowflake/localtemporal release paths.
RUN apt-get -y update && apt install -y sudo
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates curl

USER root

ENV PATH /root/.local/bin:$PATH
ENV LD_LIBRARY_PATH /root/.local/lib:$LD_LIBRARY_PATH

WORKDIR /root

RUN for i in 1 2 3 4 5; do (curl -sSf https://temporal.download/cli.sh) && break || sleep 5; done | sh
ENV PATH /root/.temporalio/bin:$PATH
