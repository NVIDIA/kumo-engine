# kumo backend GPU image.
#
# Hosts activity-scoped pool pods that run train/predict via GPU
# subprocesses (kumo-auto, kumo-pred):
#   - Pool activity pod (cache)     mounts daemon's PVC, runs train/predict
#   - Pool activity pod (overflow)  emptyDir on eph node, runs train/predict
#
# Same kumo source tree as Dockerfile.kumo_backend_cpu — the only
# functional differences are: GPU torch+cu132 stack, NVIDIA env (from
# the GPU base), and the GPU subprocess binaries under /opt/app/bin/.
#
# Self-contained build: the `base` stage below (CUDA runtime + Python 3.14 +
# GPU torch+cu132) derives directly from NVIDIA's public cuda image, so there
# is no separate kumo-base image / intermediate ECR base to certify.

# ---------------------------------------------------------------------------
# base stage — CUDA runtime + Python 3.14 toolchain + torch+cu132
# and heavy stable pip deps. Formerly the standalone kumo-base-gpu image;
# inlined here so the backend builds directly on NVIDIA's public cuda image
# with no intermediate ECR image. Both stages below derive from it.
#
# CUDA 13 is the only supported GPU runtime and requires driver >=580.
# NVIDIA-hosted cuda image (nvcr.io) keeps the lineage off Docker Hub / ECR
# for NGC supply-chain provenance.
# ---------------------------------------------------------------------------
FROM nvcr.io/nvidia/cuda:13.3.0-runtime-ubuntu24.04 AS base

ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

# Surface the GPU to consumers — used by torch and the kumo-auto/-pred
# subprocesses spawned by pool worker activity pods.
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update -y \
 && apt-get install -y --no-install-recommends sudo \
 && groupadd -g ${GID} ${GROUPNAME} \
 && useradd -m -d /home/${USERNAME} -g ${GID} -u ${UID} -s /bin/bash ${USERNAME} \
 && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
 && chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME} \
 && rm -rf /var/lib/apt/lists/*

USER ${USERNAME}

ENV PATH=/home/${USERNAME}/.local/bin:$PATH
ENV LD_LIBRARY_PATH=/home/${USERNAME}/.local/lib:$LD_LIBRARY_PATH

WORKDIR /home/${USERNAME}

# CUDA 13.2 PyTorch selects Toolkit 13.2.1, above the CVE-2025-33228 fix floor.
# Keep the existing CUDA 13.3 base and CUDA 13 Faiss wheel.
# Build context is the kumo repo root, so the script lives at docker/.
COPY --chmod=755 docker/kumodeps_base /home/${USERNAME}/kumodeps_base
RUN CUDA_VERSION=cu132 /home/${USERNAME}/kumodeps_base \
 && rm /home/${USERNAME}/kumodeps_base

COPY docker/postgres-ca-bundles /tmp/postgres-ca-bundles
COPY --chmod=755 docker/install_postgres_ca_bundles /tmp/
USER root
RUN /tmp/install_postgres_ca_bundles /tmp/postgres-ca-bundles \
 && rm -rf /tmp/install_postgres_ca_bundles /tmp/postgres-ca-bundles
USER ${USERNAME}

# ---------------------------------------------------------------------------
# diskgraph-builder — Rust + build tools to compile the DiskGraph wheel.
# None of this toolchain lands in the runtime stage.
# ---------------------------------------------------------------------------
FROM base AS diskgraph-builder

USER root
ENV PATH=/root/.cargo/bin:$PATH
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        lld \
        pkg-config \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf \
  https://raw.githubusercontent.com/rust-lang/rustup/d95a37b6ab92cc1e455d1576039333c97ca3e2c5/rustup-init.sh \
 | sh -s -- -y --profile minimal --default-toolchain stable

# Build the internal DiskGraph wheel from the staged in-tree source.
COPY docker/diskgraph-source/ /tmp/staged-diskgraph-source/
COPY docker/build_diskgraph_wheel /tmp/build_diskgraph_wheel
RUN chmod +x /tmp/build_diskgraph_wheel \
 && /tmp/build_diskgraph_wheel /tmp/diskgraph-wheel

# FAISS remains a local ARM64 source build until its publication policy is
# resolved. Keep that compiler toolchain isolated from both the runtime image
# and the AMD64 build path.
FROM base AS faiss-builder

ARG TARGETARCH
ARG CUDA_ARCH_LIST
USER root
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
        test -n "${CUDA_ARCH_LIST}" \
        || { echo "CUDA_ARCH_LIST is required for ARM64 GPU wheels" >&2; exit 1; }; \
        apt-get update -y \
     && apt-get install -y --no-install-recommends \
            cuda-nvrtc-dev-13-3 \
            cuda-minimal-build-13-3 \
            libcublas-dev-13-3=13.5.1.27-1 \
            libcurand-dev-13-3 \
            libopenblas-dev \
            libcusolver-dev-13-3=12.2.2.18-1 \
            libcusparse-dev-13-3=12.8.1.7-1 \
     && rm -rf /var/lib/apt/lists/*; \
    fi
COPY scripts/build_faiss_gpu_arm64_wheel.sh /tmp/faiss-src/scripts/build_faiss_gpu_arm64_wheel.sh
RUN if [ "${TARGETARCH}" = "arm64" ]; then python3 -m pip install uv; fi
RUN mkdir -p /tmp/faiss-wheel \
 && if [ "${TARGETARCH}" = "arm64" ]; then \
        wheel_dir="$(FAISS_CUDA_ARCHES="${CUDA_ARCH_LIST}" \
            FAISS_GPU_CACHE_DIR=/tmp/faiss-cache \
            /tmp/faiss-src/scripts/build_faiss_gpu_arm64_wheel.sh \
                --python /usr/bin/python3 --cuda cu130)" \
        && cp "${wheel_dir}"/faiss_gpu-*.whl /tmp/faiss-wheel/; \
    fi

FROM base

ARG TARGETARCH
ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

ENV TORCH=2.12.0
ENV CUDA=cu132

# Bake GloVe embeddings into the image (see install_glove_files):
#   basic (default), all, none.
ARG BAKE_GLOVE_LEVEL=basic

# Version string for the kumo Python package (consumed by setuptools-scm
# during the final `uv pip install`). Defaults to a dev sentinel so builds
# work when .git isn't in the build context (e.g. when .dockerignore
# excludes it). CI can pass a real version (e.g. branch SHA) here.
ARG KUMO_VERSION=0.0.0+dev
ENV SETUPTOOLS_SCM_PRETEND_VERSION_FOR_KUMO=${KUMO_VERSION}

# CVE patches against latest available at backend rebuild time. Kept here
# (not in base) so we pick up updates without forcing a base rebuild.
# openssh is purged outright: nothing sshes into these containers (k8s uses
# exec), and the openssh packages carry unfixable scanner findings.
USER root
RUN apt-get update -y \
 && apt-get upgrade -y \
 && apt-get install -y --no-install-recommends libopenblas0 \
 && DEBIAN_FRONTEND=noninteractive apt-get purge -y \
        ssh openssh-server openssh-client openssh-sftp-server \
 && apt-get autoremove -y \
 # Some base tags ship a stray non-dpkg /usr/bin/ssh that survives the apt
 # purge; remove it explicitly to satisfy the `! command -v ssh` assertion.
 && rm -f /usr/bin/ssh /usr/bin/scp /usr/bin/sftp /usr/bin/ssh-* /usr/sbin/sshd \
 && rm -rf /etc/ssh /var/lib/apt/lists/*

RUN mkdir -p /opt/app /opt/app/src /opt/app/bin \
 && chown -R ${USERNAME}:${GROUPNAME} /opt/app
USER ${USERNAME}
RUN mkdir -p /opt/app/src/scripts

# ---------------------------------------------------------------------------
# Dependency-install layer.
#
# Build context = kumo repo root. To keep the uv.lock install cached
# across edits to kumo source, we first copy only the files setuptools needs
# to evaluate setup.py / pyproject.toml and resolve the dep set:
#   - pyproject.toml / uv.lock / setup.py / setup.cfg   project metadata + lock
#   - packages/kumo-api                         shared public contracts
#   - packages/kumo-pql                         PQL parser and validator
#   - packages/kumo-core                        shared portable implementation
#   - packages/kumo-snowflake                   Snowflake source reader
#   - packages/kumo-databricks                  Databricks source reader
#   - packages/kumo-bigquery                    BigQuery source reader
#   - packages/kumo-s3                          S3 session binding
#   - packages/kumo-gcs                         GCS source access
#   - README.md                                 referenced by pyproject.toml
#   - bin/kumo-*                                console scripts declared in setup.py
# Plus an empty kumo/__init__.py stub so `find_packages()` returns ['kumo'].
# After deps are installed we overlay the full source and reinstall with
# --no-deps to register the real package.
# ---------------------------------------------------------------------------
COPY pyproject.toml uv.lock setup.py setup.cfg README.md /opt/app/src/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-api/ \
    /opt/app/src/packages/kumo-api/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-pql/ \
    /opt/app/src/packages/kumo-pql/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-core/ \
    /opt/app/src/packages/kumo-core/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-snowflake/ \
    /opt/app/src/packages/kumo-snowflake/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-databricks/ \
    /opt/app/src/packages/kumo-databricks/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-bigquery/ \
    /opt/app/src/packages/kumo-bigquery/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-s3/ \
    /opt/app/src/packages/kumo-s3/
COPY --chown=${USERNAME}:${GROUPNAME} packages/kumo-gcs/ \
    /opt/app/src/packages/kumo-gcs/
# kumo-engine, kumo-glove-6b-50d and the DiskGraph source are deliberately not
# copied here (the first two are excluded via .dockerignore; DiskGraph is built
# in the diskgraph-builder stage; GloVe is baked separately below). `uv export`
# and the --no-sources member installs below don't need them on disk.
COPY 3rdparty/ /opt/app/src/3rdparty/
COPY bin/ /opt/app/src/bin/
USER root
RUN chmod -R a+rX /opt/app/src
USER ${USERNAME}
RUN mkdir -p /opt/app/src/kumo \
 && touch /opt/app/src/kumo/__init__.py

# DiskGraph wheel is built in the builder stage so Rust/Cargo never land in
# the runtime image.
COPY --from=diskgraph-builder /tmp/diskgraph-wheel /tmp/diskgraph-wheel
COPY docker/install_glove_files /tmp/
COPY docker/busyloop.sh /opt/app/busyloop.sh

WORKDIR /opt/app/src

# Install system dependencies as root. Rootless Buildah preserves ownership
# from earlier layers, so a non-root `uv --system` cannot reliably replace
# packages already present in the base image.
USER root

# Install kumo + transitive deps in a single uv resolution. Keep this
# buildah-compatible because the custom image workflows build with buildah.
COPY --from=faiss-builder /tmp/faiss-wheel /tmp/faiss-wheel

RUN python3 -m pip install uv

# DiskGraph is the internal native wheel built from the staged source.
# Install it before resolving kumo-core so uv uses this artifact.
RUN UV_LINK_MODE=copy python3 -m uv pip install --system --no-deps \
        /tmp/diskgraph-wheel/*.whl

# Third-party dependencies come from the committed uv.lock, exported for the
# `full` + `${CUDA}` extras (cpu/cu132, which also select torch and kumo-core's
# faiss build) and installed with --no-deps so nothing is re-resolved. The
# workspace members are excluded from the export and installed below.
#
# `--torch-backend=${CUDA}` points torch at the matching PyTorch index so the
# lock's +${CUDA} wheel is found without fanning unrelated packages out to
# download.pytorch.org. Custom Faiss wheels come from --find-links.
#
# diskgraph is already installed above from the prebuilt wheel.
#
# faiss-gpu comes from the lock (public wheel) unless a locally built wheel is
# staged: the ARM64 source build in /tmp/faiss-wheel (no public ARM wheel) or
# an AMD64 override in 3rdparty/kumo-wheels. Only wheels matching the target
# architecture are considered, /tmp/faiss-wheel first. In that case faiss-gpu
# and its CUDA 12 runtime dependencies (reachable only through the public
# wheel; the override is CUDA 13) are dropped from the export and the local
# wheel is installed instead.
# The uv cache is wiped at the end of the RUN -- it sits at ~/.cache/uv and is
# otherwise several GB of unpacked wheels in the final image.
RUN set -- \
        --no-emit-package diskgraph \
 && faiss_wheel="" \
 && for w in /tmp/faiss-wheel/faiss_gpu-*"$(uname -m)"*.whl \
             /opt/app/src/3rdparty/kumo-wheels/faiss_gpu-*"$(uname -m)"*.whl; do \
        if [ -f "${w}" ]; then faiss_wheel="${w}"; break; fi; \
    done \
 && if [ -n "${faiss_wheel}" ]; then \
        set -- "$@" \
            --no-emit-package faiss-gpu \
            --no-emit-package nvidia-cublas-cu12 \
            --no-emit-package nvidia-cuda-nvrtc-cu12 \
            --no-emit-package nvidia-cuda-runtime-cu12 \
            --no-emit-package nvidia-curand-cu12; \
    fi \
 && python3 -m uv export --frozen --no-header --no-emit-workspace \
        --extra full --extra "${CUDA}" "$@" \
        --output-file /tmp/requirements.txt \
 && UV_LINK_MODE=copy python3 -m uv pip install --system --no-deps \
        --find-links ./3rdparty/kumo-wheels/ \
        --torch-backend="${CUDA}" \
        -r /tmp/requirements.txt \
 && if [ -n "${faiss_wheel}" ]; then \
        UV_LINK_MODE=copy python3 -m uv pip install --system --no-deps "${faiss_wheel}"; \
    fi \
 && rm -rf /tmp/requirements.txt /root/.cache/uv

# Register the local API, PQL, core and source-reader packages as regular
# (non-editable) installs: the source overlay below `rm -rf`s /opt/app/src, so
# editable installs would dangle. Their dependencies are already in the lock
# export above. --no-sources ignores their `workspace = true` entries (e.g.
# kumo-glove-6b-50d), which would otherwise require every referenced member to
# be on disk.
RUN UV_LINK_MODE=copy python3 -m uv pip install --system --no-deps --no-sources \
        /opt/app/src/packages/kumo-api \
        /opt/app/src/packages/kumo-pql \
        /opt/app/src/packages/kumo-core \
        /opt/app/src/packages/kumo-snowflake \
        /opt/app/src/packages/kumo-databricks \
        /opt/app/src/packages/kumo-bigquery \
        /opt/app/src/packages/kumo-s3 \
        /opt/app/src/packages/kumo-gcs \
 && rm -rf /root/.cache/uv

# Validate the staged DiskGraph runtime.
RUN python3 -c "from diskgraph import SamplerEngine; print('diskgraph import ok')" \
 && python3 -c "import os, diskgraph; from pathlib import Path; ingest = Path(diskgraph.__file__).parent / 'bin' / 'ingest'; assert ingest.is_file() and os.access(ingest, os.X_OK), ingest; print(f'diskgraph ingest binary ok: {ingest}')"

# Signed GloVe bake. kumo-public-datasets is private, so install_glove_files
# must sign with AWS credentials. The final image has no aws CLI, so it uses
# boto3 (a core dep). Credentials arrive as build-args scoped to this single
# RUN — referenced only as env for the boto3 call, never promoted to ENV, so
# they do not persist in the image.
# NOTE(trivy): CI passes these via secret mounts (RUN --mount below); the
# ARGs are the plain-`docker build` fallback, never promoted to ENV.
#trivy:ignore:AVD-DS-0031
ARG AWS_ACCESS_KEY_ID
#trivy:ignore:AVD-DS-0031
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_SESSION_TOKEN
ARG AWS_REGION=us-west-2
RUN --mount=type=secret,id=aws_access_key_id,mode=0444 \
    --mount=type=secret,id=aws_secret_access_key,mode=0444 \
    --mount=type=secret,id=aws_session_token,mode=0444 \
    AWS_ACCESS_KEY_ID="$([ -f /run/secrets/aws_access_key_id ] && cat /run/secrets/aws_access_key_id || printf '%s' "${AWS_ACCESS_KEY_ID}")" \
    AWS_SECRET_ACCESS_KEY="$([ -f /run/secrets/aws_secret_access_key ] && cat /run/secrets/aws_secret_access_key || printf '%s' "${AWS_SECRET_ACCESS_KEY}")" \
    AWS_SESSION_TOKEN="$([ -f /run/secrets/aws_session_token ] && cat /run/secrets/aws_session_token || printf '%s' "${AWS_SESSION_TOKEN}")" \
    AWS_DEFAULT_REGION=${AWS_REGION} \
    BAKE_GLOVE_LEVEL=${BAKE_GLOVE_LEVEL} /tmp/install_glove_files

RUN ! command -v aws \
 && ! command -v cargo \
 && ! command -v rustc \
 && ! command -v rustup \
 && ! command -v java \
 && ! command -v ssh \
 && ! command -v sshd \
 && test ! -f /root/.gitconfig

# AMD64 may use the public wheel or a locally staged architecture override.
# ARM64 uses the source-built wheel because no Linux ARM wheel exists.
RUN if [ "${TARGETARCH}" = "arm64" ]; then \
        python3 -c "import importlib.metadata as m, faiss; from pathlib import PurePosixPath; dist = m.distribution('faiss-gpu'); assert dist.version == '1.14.3'; assert hasattr(faiss, 'StandardGpuResources'); legal = {PurePosixPath(str(item)).name for item in dist.files or () if '.dist-info/licenses/' in str(item)}; expected = {'LICENSE', 'THIRD_PARTY_NOTICES'}; assert expected <= legal, expected - legal"; \
    else \
        python3 -c "import importlib.metadata as m, faiss; dist = m.distribution('faiss-gpu'); assert dist.version.startswith('1.14.3'); assert hasattr(faiss, 'StandardGpuResources'); files = {str(item) for item in dist.files or ()}; prefixes = ('faiss_gpu.libs/libgfortran-', 'faiss_gpu.libs/libgomp-', 'faiss_gpu.libs/libopenblas', 'faiss_gpu.libs/libquadmath-'); missing = {prefix for prefix in prefixes if not any(item.startswith(prefix) for item in files)} if dist.version == '1.14.3+cu130sm120' else set(); assert not missing, missing"; \
    fi

# ---------------------------------------------------------------------------
# Source overlay.
#
# Now copy the real repo over the stub. Cache busts from here on any source
# change, but the heavy lock install above is preserved. The follow-up
# `uv pip install --no-deps .` rebuilds the kumo wheel against real source
# without re-resolving dependencies.
# ---------------------------------------------------------------------------
COPY . /opt/app/src
COPY kumo_version.txt /home/${USERNAME}/

# GPU subprocess binaries spawned by pool/activities.py::_run_kumo_subprocess.
COPY bin/kumo-auto /opt/app/bin/
COPY bin/kumo-pred /opt/app/bin/
USER root
RUN chmod -R a+rX /opt/app/src \
 && chmod a+r /home/${USERNAME}/kumo_version.txt \
 && chmod -R 755 /opt/app/bin/

RUN rm -rf /opt/app/src/build /opt/app/src/*.egg-info
RUN UV_LINK_MODE=copy python3 -m uv pip install --system --no-deps \
        --reinstall-package kumo \
        /opt/app/src \
 && rm -rf /root/.cache/uv

# uv and pip are build-time tools only.
# Retry transient ENOTEMPTY errors from fuse-overlayfs.
RUN for cleanup_attempt in 1 2 3; do \
      rm -rf \
        /usr/local/lib/python*/dist-packages/uv \
        /usr/local/lib/python*/dist-packages/uv-*.dist-info \
        /usr/local/lib/python*/dist-packages/pip \
        /usr/local/lib/python*/dist-packages/pip-*.dist-info \
        /usr/local/lib/python*/site-packages/uv \
        /usr/local/lib/python*/site-packages/uv-*.dist-info \
        /usr/local/lib/python*/site-packages/pip \
        /usr/local/lib/python*/site-packages/pip-*.dist-info && break; \
      test "${cleanup_attempt}" -lt 3 || exit 1; \
      sleep 1; \
    done \
 && rm -f \
        /usr/local/bin/uv \
        /usr/local/bin/uvx \
        /usr/local/bin/pip \
        /usr/local/bin/pip3 \
        /usr/local/bin/pip3.* \
 && ! command -v uv \
 && ! command -v pip \
 && ! command -v pip3

# Source preservation — same set as backend_cpu; the choice of GPU vs
# CPU is independent of which entry-point services run. Activity pods
# typically only invoke pool/worker_main, but keeping the full source
# tree leaves the image flexible for any future GPU-side service.
WORKDIR /opt/app
USER root
# restricted-v2 assigns an arbitrary UID in group 0.
# Add supplemental native-runtime entries only for the custom AMD64 wheel.
RUN set -- \
        --artifact backend-antlr4-runtime \
        --artifact backend-cloudpickle-runtime \
        --artifact diskgraph-extension \
        --artifact diskgraph-ingest \
        --artifact kumo-bundled-source \
        --artifact kumo-core-bundled-source \
 && if [ "${TARGETARCH}" = "amd64" ] && python3 -c "import importlib.metadata as m; raise SystemExit(m.version('faiss-gpu') != '1.14.3+cu130sm120')"; then set -- "$@" --artifact backend-faiss-gpu-amd64-native; fi \
 && if [ "${BAKE_GLOVE_LEVEL}" != "none" ]; then set -- "$@" --artifact backend-baked-glove; fi \
 && python3 -c "import importlib.metadata as m; assert m.version('antlr4-python3-runtime') == '4.9.3'; assert m.version('cloudpickle') == '3.1.1'" \
 && python3 /opt/app/src/scripts/gen_third_party.py "$@" \
        --output /usr/share/licenses/kumo/THIRD-PARTY.txt \
 && install -D -m 0644 /opt/app/src/LICENSE /usr/share/licenses/kumo/LICENSE \
 && test -s /usr/share/licenses/kumo/LICENSE \
 && test -s /usr/share/licenses/kumo/THIRD-PARTY.txt \
 && if [ "${TARGETARCH}" = "amd64" ] && python3 -c "import importlib.metadata as m; raise SystemExit(m.version('faiss-gpu') != '1.14.3+cu130sm120')"; then test -s /usr/share/common-licenses/GPL-3 && test -s /usr/share/common-licenses/LGPL-2.1; fi \
 && mv /opt/app/src/rest /opt/app/ \
 && mv /opt/app/src/temporalio_commons /opt/app/ \
 && mv /opt/app/src/pool /opt/app/ \
 && rm -rf /opt/app/src \
 && chown -R ${USERNAME}:${GROUPNAME} /opt/app \
 && chgrp -R 0 /home/${USERNAME} \
 && chmod -R g=u,o+rX /home/${USERNAME}
# Numeric UID:GID so the kubelet can verify `runAsNonRoot: true` (set by
# pool/worker_manager/k8s.py); a name here yields "cannot verify user is
# non-root" and the container never starts.
USER ${UID}:${GID}

ENV PATH=/home/${USERNAME}/.local/bin:/opt/app/bin:/usr/bin:$PATH
ENV PYTHONPATH=/opt/app:${PYTHONPATH:-}
ENV HOME=/home/${USERNAME}
ENV USER=${USERNAME}
ENV LOGNAME=${USERNAME}
ENV KUMO_HOME=/tmp/kumo
ENV KUMO_GLOVE_PATH=/opt/app/artifacts/glove
# Keep library caches on the writable cache volume without hiding HOME/.local.
ENV XDG_CACHE_HOME=/home/${USERNAME}/.cache
ENV CUDA_CACHE_PATH=/home/${USERNAME}/.cache/nv/ComputeCache
ENV TRITON_CACHE_DIR=/home/${USERNAME}/.cache/triton

# Health is owned by K8s probes; no Docker-level healthcheck by design.
HEALTHCHECK NONE
CMD ["/opt/app/busyloop.sh"]
