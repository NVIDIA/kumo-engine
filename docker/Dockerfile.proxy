# Pinned to the same nginx minor as docker-compose.singlehost.yml.
FROM public.ecr.aws/docker/library/nginx:1.29

# Copy the modified nginx.conf file to container
COPY nginx.conf /etc/nginx/nginx.conf

# Expose port 8888 for incoming traffic
EXPOSE 8888

# Run as the unprivileged nginx user: pid lives in /tmp (see nginx.conf),
# config must be world-readable (COPY preserves context mode), cache writable.
RUN chmod 644 /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx
USER nginx

# Start nginx on container startup
CMD ["nginx", "-g", "daemon off;"]

# Health is owned by the deployment platform; no Docker-level healthcheck.
HEALTHCHECK NONE
