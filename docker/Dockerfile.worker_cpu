##################################################################################
#                                                                               #
# Dockerfile to build base image for k8s train/predict worker on CPU machine.
#                                                                               #
##################################################################################

# Use Kumo cpu base image
FROM --platform=linux/amd64 926922431314.dkr.ecr.us-west-2.amazonaws.com/kumo/kumo-cpu:base-314-torch2120-ubuntu22

ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

ENV TORCH 2.12.0
ENV CUDA cpu
ENV JAVA_HOME /usr/lib/jvm/java-17-openjdk-amd64

# AWS credentials (used for build-time S3 fetches).
# NOTE(trivy): build-arg secrets are weaker than secret mounts (can land in
# image history/layers, e.g. via the git-config RUN); migration is a follow-up.
#trivy:ignore:AVD-DS-0031
ARG AWS_ACCESS_KEY_ID
#trivy:ignore:AVD-DS-0031
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_REGION=us-west-2
# When running on GitHub, this token provides access to private Kumo repos.
#trivy:ignore:AVD-DS-0031
ARG GITHUB_TOKEN
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

USER ${USERNAME}

RUN mkdir /home/${USERNAME}/src
USER root
RUN mkdir /opt/app
RUN mkdir /opt/app/bin
RUN chown -R ${USERNAME}:${GROUPNAME} /opt/app
RUN chown -R ${USERNAME}:${GROUPNAME} /opt/app/bin
RUN chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}/src
USER ${USERNAME}

COPY ./kumo /home/${USERNAME}/src/
USER root
RUN chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}/src
USER ${USERNAME}
RUN ls -lrt /home/${USERNAME}/src/
COPY ./kumo/bin/ /opt/app/bin/
USER root
RUN chmod -R 755 /opt/app/bin/
USER ${USERNAME}
RUN ls -lrt /opt/app/bin/

COPY install_kumo /tmp/install_kumo
COPY busyloop.sh /opt/app/busyloop.sh

# Build and package Kumo
WORKDIR /home/${USERNAME}/src

RUN python3 -m pip show torch
RUN python3 -m pip uninstall scikit-learn -y
RUN python3 -m pip uninstall pandas -y
RUN python3 -m pip uninstall numpy -y
# TODO(dong) remove after new base image build.
RUN python3 -m pip uninstall temporalio -y
RUN python3 -m pip uninstall fsspec -y
RUN python3 -m pip install --no-deps -e packages/kumo-api -e packages/kumo-pql
RUN python3 -m pip install ".[full]" -f 3rdparty/kumo-wheels/
RUN python3 -m pip show torch
RUN python3 -m pip cache purge

# Remove Kumo sources
USER root
RUN rm -rf /home/${USERNAME}/src/*
USER ${USERNAME}

# Set PATH
ENV PATH /home/${USERNAME}/.local/bin:/usr/bin:$PATH
ENV LD_LIBRARY_PATH /opt/conda/lib
ENV PYTHONPATH "${PYTHONPATH}:/opt/app"

CMD /opt/app/busyloop.sh

# Health is owned by K8s probes; no Docker-level healthcheck by design.
HEALTHCHECK NONE
