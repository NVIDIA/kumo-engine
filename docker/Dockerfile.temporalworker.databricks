##################################################################################
#                                                                                #
# Dockerfile used to create Kumo control plane temporal worker pod               #
#                                                                                #
##################################################################################

# Use Kumo base image
FROM 926922431314.dkr.ecr.us-west-2.amazonaws.com/kumo/kumo-cpu:base-314-torch2120-ubuntu22

ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

ENV TORCH 2.12.0
ENV CUDA cu130
ENV JAVA_HOME /usr/lib/jvm/java-17-openjdk-amd64

ARG AWS_REGION=us-west-2
# When running on GitHub, this token provides access to private Kumo repos.
ARG GITHUB_TOKEN
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

USER ${USERNAME}

RUN mkdir /home/${USERNAME}/src
RUN sudo mkdir /opt/app
RUN sudo chown -R ${USERNAME}:${GROUPNAME} /opt/app

COPY ./kumo /home/${USERNAME}/src/
RUN sudo chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}/src
COPY ./kumo_version.txt /home/${USERNAME}/
COPY install_glove_files /tmp/install_glove_files
COPY busyloop.sh /opt/app/busyloop.sh

# Build and package Kumo
WORKDIR /home/${USERNAME}/src

# Download job cluster deps (JARs + run.py) to be synced to customer UCV at runtime.
RUN --mount=type=secret,id=aws_access_key_id,uid=999,gid=999,mode=0400 \
    --mount=type=secret,id=aws_secret_access_key,uid=999,gid=999,mode=0400 \
    --mount=type=secret,id=aws_session_token,uid=999,gid=999,mode=0400 \
    mkdir -p ~/.cache/kumo/databricks_job_cluster_deps \
    && AWS_ACCESS_KEY_ID="$(cat /run/secrets/aws_access_key_id)" \
    AWS_SECRET_ACCESS_KEY="$(cat /run/secrets/aws_secret_access_key)" \
    AWS_SESSION_TOKEN="$(cat /run/secrets/aws_session_token)" \
    AWS_DEFAULT_REGION=${AWS_REGION} \
    aws s3 cp s3://kumo-databricks-public/databricks-jars/ ~/.cache/kumo/databricks_job_cluster_deps/ \
    --recursive --no-progress
RUN --mount=type=secret,id=aws_access_key_id,uid=999,gid=999,mode=0400 \
    --mount=type=secret,id=aws_secret_access_key,uid=999,gid=999,mode=0400 \
    --mount=type=secret,id=aws_session_token,uid=999,gid=999,mode=0400 \
    AWS_ACCESS_KEY_ID="$(cat /run/secrets/aws_access_key_id)" \
    AWS_SECRET_ACCESS_KEY="$(cat /run/secrets/aws_secret_access_key)" \
    AWS_SESSION_TOKEN="$(cat /run/secrets/aws_session_token)" \
    AWS_DEFAULT_REGION=${AWS_REGION} \
    /tmp/install_glove_files
ENV KUMO_GLOVE_PATH=/opt/app/artifacts/glove

# The combined uninstall → install → uninstall → install dance below is
# split across separate RUN layers so each step operates on a committed,
# consistent site-packages. Doing it in one RUN intermittently left stale
# files in site-packages/docutils/ (kumo-ai/kumo#28332), causing the
# second pip install to fail with "Directory not empty". Same fix as
# Dockerfile.rest.databricks (PR #28333).

# 1. Drop the base-image version of numpy so the next install doesn't have to
#    overwrite binaries in place.
RUN python3 -m pip uninstall -y numpy

# 2. Install the full Kumo dependency set on top of the base image.
RUN python3 -m pip install --no-deps -e packages/kumo-api -e packages/kumo-pql
RUN python3 -m pip install \
      pycryptodomex==3.18.0 \
      oscrypto==1.3.0 \
      ".[full]" \
      -f 3rdparty/kumo-wheels/

# 3. Install the Databricks client required by this image variant.
RUN python3 -m pip uninstall -y databricks-connect \
 && python3 -m pip install databricks-connect==14.1.1 \
 && python3 -m pip freeze \
 && python3 -m pip cache purge

WORKDIR /opt/app
# Keep temporalio_commons
RUN sudo mv /home/${USERNAME}/src/temporalio_commons/ /opt/app/
RUN ls -lrt /opt/app/temporalio_commons/
# Remove everything else.
RUN sudo rm -rf /home/${USERNAME}/src

# Set PATH
ENV PATH /home/${USERNAME}/.local/bin:/usr/bin:$PATH
ENV LD_LIBRARY_PATH /opt/conda/lib
ENV PYTHONPATH "${PYTHONPATH}:/opt/app"

CMD /opt/app/busyloop.sh
