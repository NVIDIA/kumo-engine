##################################################################################
#                                                                                #
# Dockerfile used to create Kumo Data Plane temporal worker pod                  #
#                                                                                #
##################################################################################

# Use Kumo base image
# CUDA 13 / cu130 is required for all GPU images (driver >=580).
FROM 926922431314.dkr.ecr.us-west-2.amazonaws.com/kumo/kumo:base-314-cu130-torch2120-ubuntu22

ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

ENV TORCH 2.12.0
ENV CUDA cu130
ENV JAVA_HOME /usr/lib/jvm/java-17-openjdk-amd64

# Build-only AWS credentials for signed S3 artifact fetches. CI supplies
# secret mounts; these ARGs remain only as a local-build fallback.
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_SESSION_TOKEN
ARG AWS_REGION=us-west-2
# When running on GitHub, this token provides access to private Kumo repos.
ARG GITHUB_TOKEN
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

USER ${USERNAME}

RUN mkdir /home/${USERNAME}/src
RUN sudo mkdir /opt/app
RUN sudo mkdir /opt/app/bin
RUN sudo chown -R ${USERNAME}:${GROUPNAME} /opt/app
RUN sudo chown -R ${USERNAME}:${GROUPNAME} /opt/app/bin

COPY ./kumo /home/${USERNAME}/src/
RUN sudo chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}/src
COPY ./kumo_version.txt /home/${USERNAME}/
COPY ./kumo/bin/ /opt/app/bin/
RUN sudo chmod -R 755 /opt/app/bin/
RUN ls -lrt /opt/app/bin/

COPY install_glove_files /tmp/install_glove_files
COPY busyloop.sh /opt/app/busyloop.sh

# Build and package Kumo
WORKDIR /home/${USERNAME}/src
RUN --mount=type=secret,id=aws_access_key_id,mode=0444 \
    --mount=type=secret,id=aws_secret_access_key,mode=0444 \
    --mount=type=secret,id=aws_session_token,mode=0444 \
    AWS_ACCESS_KEY_ID="$([ -f /run/secrets/aws_access_key_id ] && cat /run/secrets/aws_access_key_id || printf '%s' "${AWS_ACCESS_KEY_ID}")" \
    AWS_SECRET_ACCESS_KEY="$([ -f /run/secrets/aws_secret_access_key ] && cat /run/secrets/aws_secret_access_key || printf '%s' "${AWS_SECRET_ACCESS_KEY}")" \
    AWS_SESSION_TOKEN="$([ -f /run/secrets/aws_session_token ] && cat /run/secrets/aws_session_token || printf '%s' "${AWS_SESSION_TOKEN}")" \
    AWS_DEFAULT_REGION=${AWS_REGION} /tmp/install_glove_files
ENV KUMO_GLOVE_PATH=/opt/app/artifacts/glove

RUN python3 -m pip show torch
RUN python3 -m pip uninstall scikit-learn -y
RUN python3 -m pip uninstall numpy -y
RUN python3 -m pip uninstall pandas -y
# TODO(dong) remove after new base image build.
RUN python3 -m pip uninstall temporalio -y
RUN python3 -m pip uninstall fsspec -y
RUN python3 -m pip install --no-deps -e packages/kumo-api -e packages/kumo-pql
RUN python3 -m pip install ".[full]" -f 3rdparty/kumo-wheels/
RUN python3 -m pip uninstall databricks-connect -y
# Install databricks-connect in compute worker to enable databricks push down compute.
# This is needed in bp job to rematerialize prediction table edges.
RUN python3 -m pip install databricks-connect==14.1.1
RUN python3 -m pip show torch
RUN python3 -m pip cache purge

# faiss-gpu comes from .[full] (1.14.3, cp310-abi3 — runs on py3.14).

# Remove Kumo sources
RUN sudo rm -rf /home/${USERNAME}/src/*

# Set PATH
ENV PATH /home/${USERNAME}/.local/bin:/usr/bin:$PATH
ENV LD_LIBRARY_PATH /opt/conda/lib
ENV PYTHONPATH "${PYTHONPATH}:/opt/app"

CMD /opt/app/busyloop.sh
