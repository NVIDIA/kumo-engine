FROM --platform=linux/amd64 ubuntu:22.04

# Update package metadata
RUN apt-get -y update && apt install -y sudo

ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

ENV JAVA_HOME /usr/lib/jvm/java-17-openjdk-amd64

RUN groupadd -g ${GID} ${GROUPNAME} \
    && useradd -m -d /home/${USERNAME} -g ${GID} -u ${UID} -s /bin/bash ${USERNAME}
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" | sudo tee -a /etc/sudoers

# Set permissions
RUN chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}
USER ${USERNAME}

# Set PATH
ENV PATH /home/${USERNAME}/.local/bin:$PATH
ENV LD_LIBRARY_PATH /home/${USERNAME}/.local/lib:$LD_LIBRARY_PATH

# Change workdir
WORKDIR /home/${USERNAME}

# Install deps
COPY kumodeps_cpu /home/${USERNAME}
RUN /home/${USERNAME}/kumodeps_cpu

# Health is owned by K8s probes; no Docker-level healthcheck by design.
HEALTHCHECK NONE
