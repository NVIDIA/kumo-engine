if [ $# -ne 1 ]
then
    echo "usage: $0 <package>"
    echo "got: $@"
    exit 1
fi

python3 -m pip install --upgrade build

source_dir="$1"
base_name="$(basename "$source_dir")"
temp_dir="$(mktemp -d)"
cp -r "$source_dir" "$temp_dir"
work_dir="$temp_dir/$base_name"
python3 -m build "$work_dir"
python3 -m pip install "$work_dir/dist/"*.whl
rm -r "$temp_dir"
