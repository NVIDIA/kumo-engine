{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::kumo-dataplane",
        "arn:aws:s3:::kumo-artifacts",
        "arn:aws:s3:::kumo-dev-dataplane-bucket"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::kumo-dataplane/*",
        "arn:aws:s3:::kumo-artifacts/*",
        "arn:aws:s3:::kumo-dev-dataplane-bucket/*"
      ]
    }
  ]
}
