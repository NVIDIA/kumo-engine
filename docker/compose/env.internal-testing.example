# Copy this file to .env before starting the internal-testing stack.
COMPOSE_PROJECT_NAME=kumo-internal

# Product images. The tag is the Kumo source commit used for this release.
KUMO_IMAGE_REGISTRY=nvcr.io/nvstaging/sd-kumo3
KUMO_IMAGE_TAG=bbef498dd3da8de85eff177d640fb56402dda062

DEPLOY_STAGE=prod
TEMPORAL_NAMESPACE=prod
DISABLE_AUTH=true

# Generate a unique value for every installation.
POSTGRES_USER=kumo
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
KUMO_STATE_DB_NAME=kumo

# Keep tester-owned data below this directory.
DISKGRAPH_DATA_ROOT=./data/diskgraph
LOCAL_DATAPLANE_HOST_MOUNT=./data/dataplane
LOCAL_DATAPLANE_MOUNT=/opt/app/data/dataplane
KUMO_SECRETS_DIR=./data/secrets
KUMO_GLOVE_DIR=./data/glove
KUMO_TLS_DIR=./data/tls

# Bootstrap code and checked-in service configuration.
KUMO_BOOTSTRAP_DIR=../../deploy/shared
NGINX_CONFIG=./config/nginx.production-local.conf
NGINX_CONFIG_MOUNT=/etc/kumo/nginx/nginx.conf
PROMETHEUS_CONFIG=./config/prometheus.production-local.yml
PROMETHEUS_CONFIG_MOUNT=/etc/kumo/prometheus/prometheus.yml

# nginx is the only published service.
NGINX_PORT=8888
