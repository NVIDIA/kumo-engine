KUMO_IMAGE_TAG=latest
DEPLOY_STAGE=prod
TEMPORAL_NAMESPACE=prod
DISABLE_AUTH=true

# DiskGraph stays on local VM SSD even when dataplane/artifacts are cloud
# storage. compose-local appends $STACK/diskgraph to this base path.
DISKGRAPH_DATA_ROOT=/mnt/localssd
LOCAL_DISKGRAPH_DATA=/mnt/localssd

# Dataplane/artifact roots used by preflight to generate the stack-scoped
# config under config/generated/$STACK/.
# Supported schemes include local paths, s3://..., gs://..., and abfss://...
# compose-local inserts $STACK before {instance_id}; {instance_id} is expanded
# by the app at runtime.
#
# auto detects the cloud provider and prefers the provider test bucket:
#   aws   -> s3://kumo-test-dataplane-bucket/compose-local/...
#   gcp   -> gs://kumo-test-bucket/compose-local/...
#   azure -> abfss://test-container@kumotestdataplane.../devserver2/...
# If the instance cannot write to the provider bucket, compose-local falls
# back to repo-local .cache/kumo storage.
COMPOSE_LOCAL_CLOUD_PROVIDER=auto
PRODUCTION_LOCAL_DATAPLANE_ROOT=auto
PRODUCTION_LOCAL_ARTIFACT_ROOT=auto

# Keep local Compose startup independent of cloud credentials. Set to `basic`
# or `all` explicitly when testing text features that require baked GloVe.
COMPOSE_LOCAL_GLOVE_LEVEL=none

# Optional ADLS storage account used only when the resolved dataplane root is abfss://.
AZURE_STORAGE_ACCOUNT=kumotestdataplane

# Local bind mount used only when the resolved dataplane root is a local path.
# scripts/compose-local-preflight.sh replaces these defaults with
# <repo>/.cache/kumo/compose-local/... unless the caller sets them explicitly.
LOCAL_DATAPLANE_HOST_MOUNT=
LOCAL_DATAPLANE_MOUNT=

# Config files bind at the neutral bootstrap mount paths. Preflight supplies
# stack-scoped generated source files; the bootstrap service no-ops on them.
DEPLOY_ENV_CONFIG_MOUNT=/etc/kumo/config/deploy_env_config.json
NGINX_CONFIG_MOUNT=/etc/kumo/nginx/nginx.conf
PROMETHEUS_CONFIG_MOUNT=/etc/kumo/prometheus/prometheus.yml

# Local dev credentials for bundled Postgres.
POSTGRES_USER=kumo
POSTGRES_PASSWORD=kumo
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
KUMO_STATE_DB_NAME=kumo

KUMO_SECRETS_DIR=

NGINX_CONFIG=./config/nginx.production-local.conf

KUMO_TLS_DIR=

PROMETHEUS_CONFIG=./config/prometheus.production-local.yml
