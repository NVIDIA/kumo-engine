# Development-only private-CA TLS variant of the pinned MinIO fixture.
COMPOSE_PROJECT_NAME=kumo-minio-tls
STACK=kumo-minio-tls
KUMO_IMAGE_REGISTRY=kumo
KUMO_IMAGE_TAG=latest
KUMO_CPU_IMAGE=kumo/kumo-backend-cpu:latest
POSTGRES_PASSWORD=minio-fixture-postgres-password
DEPLOY_STAGE=dev_local
DISABLE_AUTH=true
ENABLE_TLS=false
MINIO_TEST_NGINX_PORT=18889
MINIO_TEST_API_PORT=19443
DATAPLANE_ROOT=s3://kumo-dataplane/kumo
ARTIFACT_ROOT=s3://kumo-artifacts/kumo
LIFECYCLE_READY=false
S3_ENDPOINT_URL=https://minio:9000
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_CREDENTIAL_SECRET_NAME=MINIO_KUMO_CREDENTIALS
S3_CA_BUNDLE_PATH=/etc/kumo/minio-ca/ca.crt
S3_SEND_BUCKET_OWNER_FULL_CONTROL=false
KUMO_S3_CA_DIR=minio_tls_certs
