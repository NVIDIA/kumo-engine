DEPLOY_STAGE=dev
TEMPORAL_NAMESPACE=dev
DISABLE_AUTH=true
COMPOSE_PROFILES=

# The batch-validation Make targets pass concrete dataplane roots through
# BATCH_VALIDATION_DATAPLANE_* so callers can choose a fast local disk without
# editing this env file.
PRODUCTION_LOCAL_DATAPLANE_ROOT=/tmp/kumo-batch-validation/dataplane/{instance_id}/
PRODUCTION_LOCAL_ARTIFACT_ROOT=/tmp/kumo-batch-validation/dataplane/artifacts/{instance_id}/

COMPOSE_LOCAL_GLOVE_LEVEL=none
