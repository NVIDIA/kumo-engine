# This script installs dependencies for Kumo runtime docker image
sudo apt-get update -y
sudo apt-get install -y curl lsb-release software-properties-common
sudo add-apt-repository -y ppa:deadsnakes/ppa

sudo apt-get update -y
# Install the dependencies. Please keep this list sorted.
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends apt-utils \
cmake \
curl \
g++ \
gcc \
gdb \
git \
gnupg2 \
libkrb5-dev \
nvidia-utils-470 \
pass \
python3.14 \
python3.14-dbg \
python3.14-dev \
python3.14-venv \
ssh \
vim && \
sudo apt-get clean && \
sudo rm -rf /var/lib/apt/lists/*

sudo rm -rf /usr/bin/python3.6 /usr/bin/python3.6 /usr/bin/python /usr/bin/python3 && \
sudo rm -rf /usr/bin/python3.8 /usr/bin/python3.8 /usr/bin/python /usr/bin/python3 && \
sudo ln -s /usr/bin/python3.14 /usr/bin/python && \
sudo ln -s /usr/bin/python3.14 /usr/bin/python3
curl -sS https://bootstrap.pypa.io/get-pip.py | python3

python3 -m pip --version
python --version
# Pin <82 because 82+ removed pkg_resources (needed by opentelemetry at runtime
# and by pants/pex at build time). >=80.10.2 includes vendored dependency fixes
# for CVE-2026-23949 (jaraco-context) and CVE-2026-24049 (wheel).
python3 -m pip install --upgrade 'setuptools>=80.10.2,<82' pip
python3 -m pip install awscli

# Remove pip cache
python3 -m pip cache purge

# Install Pants
curl --proto '=https' --tlsv1.2 -fsSL https://static.pantsbuild.org/setup/get-pants.sh | bash
