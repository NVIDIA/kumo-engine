##################################################################################
#                                                                                #
# Dockerfile used to create Kumo control plane temporal worker pod               #
#                                                                                #
##################################################################################

# Build DiskGraph in a throwaway stage so Rust/Cargo stay out of the final
# worker image. The wheel is built from source staged into the Docker build
# context by `scripts/diskgraph stage-source --out docker/diskgraph-source`.
FROM 926922431314.dkr.ecr.us-west-2.amazonaws.com/kumo/kumo-cpu:base-314-torch2120-ubuntu22 AS diskgraph-builder

USER root
ENV PATH=/root/.cargo/bin:$PATH
RUN apt-get update -y \
 && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        git \
        lld \
        pkg-config \
        python3-pip \
 && rm -rf /var/lib/apt/lists/*
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
 | sh -s -- -y --profile minimal --default-toolchain stable

COPY diskgraph-source/ /tmp/staged-diskgraph-source/
COPY build_diskgraph_wheel /tmp/build_diskgraph_wheel
RUN chmod +x /tmp/build_diskgraph_wheel \
 && /tmp/build_diskgraph_wheel /tmp/diskgraph-wheel

# Use Kumo base image
FROM 926922431314.dkr.ecr.us-west-2.amazonaws.com/kumo/kumo-cpu:base-314-torch2120-ubuntu22

# TODO: move apt-get upgrade to base image to avoid duplicate layers across child images
USER root
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*
USER kumouser

ARG GID=999
ARG GROUPNAME=kumouser
ARG UID=999
ARG USERNAME=kumouser

ENV TORCH 2.12.0
ENV CUDA cu130
ENV JAVA_HOME /usr/lib/jvm/java-17-openjdk-amd64

ARG AWS_REGION=us-west-2
# When running on GitHub, this token provides access to private Kumo repos.
#trivy:ignore:AVD-DS-0031
ARG GITHUB_TOKEN
RUN git config --global url."https://${GITHUB_TOKEN}@github.com/".insteadOf "https://github.com/"

USER ${USERNAME}

RUN mkdir /home/${USERNAME}/src
USER root
RUN mkdir /opt/app
RUN chown -R ${USERNAME}:${GROUPNAME} /opt/app
USER ${USERNAME}

COPY ./kumo /home/${USERNAME}/src/
USER root
RUN chown -R ${USERNAME}:${GROUPNAME} /home/${USERNAME}/src
USER ${USERNAME}
COPY ./kumo_version.txt /home/${USERNAME}/
COPY --from=diskgraph-builder /tmp/diskgraph-wheel /tmp/diskgraph-wheel
COPY install_glove_files /tmp/install_glove_files
COPY busyloop.sh /opt/app/busyloop.sh

# Build and package Kumo
WORKDIR /home/${USERNAME}/src
RUN python3 -m pip install /tmp/diskgraph-wheel/*.whl --force-reinstall --no-deps \
 && python3 -c "from diskgraph import SamplerEngine; print('diskgraph import ok')" \
 && python3 -c "import os, diskgraph; from pathlib import Path; ingest = Path(diskgraph.__file__).parent / 'bin' / 'ingest'; assert ingest.is_file() and os.access(ingest, os.X_OK), ingest; print(f'diskgraph ingest binary ok: {ingest}')" \
 && ! command -v cargo \
 && ! command -v rustc \
 && ! command -v rustup
RUN --mount=type=secret,id=aws_access_key_id,uid=999,gid=999,mode=0400 \
    --mount=type=secret,id=aws_secret_access_key,uid=999,gid=999,mode=0400 \
    --mount=type=secret,id=aws_session_token,uid=999,gid=999,mode=0400 \
    AWS_ACCESS_KEY_ID="$(cat /run/secrets/aws_access_key_id)" \
    AWS_SECRET_ACCESS_KEY="$(cat /run/secrets/aws_secret_access_key)" \
    AWS_SESSION_TOKEN="$(cat /run/secrets/aws_session_token)" \
    AWS_DEFAULT_REGION=${AWS_REGION} \
    /tmp/install_glove_files
ENV KUMO_GLOVE_PATH=/opt/app/artifacts/glove

# The combined uninstall → install → uninstall → install dance below is
# split across separate RUN layers so each step operates on a committed,
# consistent site-packages. Doing it in one RUN intermittently left stale
# files in site-packages/docutils/ (kumo-ai/kumo#28332), causing the
# second pip install to fail with "Directory not empty". Same fix as
# Dockerfile.rest.databricks (PR #28333).

# 1. Drop the base-image version of numpy so the next install doesn't have to
#    overwrite binaries in place.
RUN python3 -m pip uninstall -y numpy

# 2. Install the full Kumo dependency set on top of the base image.
#    TODO: Remove awscli from here. Currently, awscli needs to be downgraded
#    to avoid incompatible botocore versions required by awscli and
#    aiobotocore.
#    Avoid pip uninstalling base-image packages from overlay-backed site-packages.
RUN python3 -m pip install --no-deps -e packages/kumo-api -e packages/kumo-pql
RUN python3 -m pip install --ignore-installed \
      pycryptodomex==3.18.0 \
      oscrypto==1.3.0 \
      awscli \
      ".[full]" \
      -f 3rdparty/kumo-wheels/

# 3. Remove the Databricks client, which is not used by this image variant.
RUN python3 -m pip uninstall -y databricks-connect \
 && python3 -m pip freeze \
 && python3 -m pip cache purge

WORKDIR /opt/app
# Keep temporalio_commons
USER root
RUN mv /home/${USERNAME}/src/temporalio_commons/ /opt/app/
USER ${USERNAME}
RUN ls -lrt /opt/app/temporalio_commons/
# Remove everything else.
USER root
RUN rm -rf /home/${USERNAME}/src
USER ${USERNAME}

# Set PATH
ENV PATH /home/${USERNAME}/.local/bin:/usr/bin:$PATH
ENV LD_LIBRARY_PATH /opt/conda/lib
ENV PYTHONPATH "${PYTHONPATH}:/opt/app"

CMD /opt/app/busyloop.sh

# Health is owned by K8s probes; no Docker-level healthcheck by design.
HEALTHCHECK NONE
