set -euo pipefail
#
# Build the internal DiskGraph wheel from source staged from packages/diskgraph.
# Runtime stages install the result without carrying Rust or Cargo.

OUT_DIR="${1:-/tmp/diskgraph-wheel}"
STAGED_SOURCE_DIR="${STAGED_SOURCE_DIR:-/tmp/staged-diskgraph-source}"

ensure_cargo() {
    if command -v cargo >/dev/null 2>&1; then
        return
    fi

    echo "cargo is required to build staged DiskGraph source" >&2
    exit 1
}

build_from_source() {
    local source_dir="${STAGED_SOURCE_DIR%/}"

    if [ ! -f "${source_dir}/pyproject.toml" ]; then
        echo "No staged DiskGraph pyproject.toml found at ${source_dir}" >&2
        exit 1
    fi
    ensure_cargo
    echo "Building DiskGraph wheel from staged source ${source_dir}"
    # DiskGraph commit 5e20bec6 has no Cargo.lock, so fresh Docker builds can
    # pick up time 0.3.48, which conflicts with aws-smithy-types 1.5.0.
    cargo update --manifest-path "${source_dir}/Cargo.toml" -p time --precise 0.3.47
    # The builder stage's distro python3-pip targets py3.10 and imports stdlib
    # distutils (removed in 3.12), so it can't run under the py3.14 base; ensurepip
    # isn't shipped on the base either. Bootstrap a modern pip via get-pip.py.
    # These bases already ship a modern pip, so --ignore-installed skips the
    # uninstall step, which is fatal on buildah overlayfs (Errno 39 dir not empty).
    curl -sSf https://bootstrap.pypa.io/get-pip.py | python3 - --ignore-installed "pip>=24" "setuptools>=70" wheel
    python3 -m pip install --no-cache-dir "maturin>=1.0,<2.0"
    PIP_DEFAULT_TIMEOUT="${PIP_DEFAULT_TIMEOUT:-60}" \
    PIP_RETRIES="${PIP_RETRIES:-10}" \
        python3 -m pip wheel --no-build-isolation --no-deps --wheel-dir "$OUT_DIR" "$source_dir"
}

verify_wheel() {
    local wheel
    wheel="$(find "$OUT_DIR" -maxdepth 1 -name 'diskgraph-*.whl' | sort | tail -n 1)"
    if [ -z "$wheel" ]; then
        echo "No diskgraph wheel found in ${OUT_DIR}" >&2
        exit 1
    fi

    python3 - "$wheel" <<'PY'
import sys
import zipfile

wheel = sys.argv[1]
with zipfile.ZipFile(wheel) as archive:
    names = set(archive.namelist())
if "diskgraph/bin/ingest" not in names:
    raise SystemExit(f"{wheel} does not contain diskgraph/bin/ingest")
print(f"diskgraph wheel ok: {wheel}")
PY
}

cleanup_build_artifacts() {
    rm -rf \
        "${STAGED_SOURCE_DIR%/}/target" \
        /root/.cache/pip
}

mkdir -p "$OUT_DIR"

build_from_source
verify_wheel
cleanup_build_artifacts
